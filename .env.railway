# Railway Environment Configuration Template
# Copy these variables to your Railway dashboard under Variables tab

# Core Application Settings
NODE_ENV=production
PORT=9000

# Database (Railway will provide this automatically)
# DATABASE_URL=${{PostgreSQL.DATABASE_URL}}

# Security Keys (Generate these with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key-here
COOKIE_SECRET=your-super-secret-cookie-key-here

# CORS Configuration
CORS_ADMIN_URL=https://your-app.railway.app
CORS_STORE_URL=https://your-storefront.com

# Medusa Configuration
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_BACKEND_URL=https://your-app.railway.app
MEDUSA_ADMIN_URL=https://your-app.railway.app/app

# Stripe Configuration (Optional)
# STRIPE_API_KEY=sk_live_... (or sk_test_... for testing)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_CLIENT_ID=ca_...

# Email Configuration (Optional - Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# Algolia Configuration (Optional)
# ALGOLIA_APP_ID=your-app-id
# ALGOLIA_ADMIN_API_KEY=your-admin-key
# ALGOLIA_SEARCH_API_KEY=your-search-key

# File Storage (Optional - AWS S3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Redis Configuration (Optional - for caching)
# REDIS_URL=redis://localhost:6379

# Additional Configuration
# DISABLE_ANALYTICS=true
# ENABLE_PROFILING=false
